{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: development",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define=APP_FLAVOR=development",
        "--dart-define=ENABLE_NETWORK_LOGS=true"
      ]
    },
    {
      "name": "Flutter: production",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define=APP_FLAVOR=production",
        "--dart-define=API_BASE_URL=https://api.example.org"
      ]
    }
  ]
}
